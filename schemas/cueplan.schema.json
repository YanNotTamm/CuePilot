{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CuePilot CuePlan",
  "description": "Canonical export format for CuePilot cue plans.",
  "type": "object",
  "required": ["schemaVersion", "track", "cues"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.0$"
    },
    "track": {
      "type": "object",
      "required": ["path", "artist", "title", "duration"],
      "properties": {
        "path": { "type": "string" },
        "artist": { "type": "string" },
        "title": { "type": "string" },
        "duration": { "type": "number", "minimum": 0 },
        "bpm": { "type": "number", "minimum": 0 },
        "key": { "type": "string" }
      }
    },
    "cues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slot", "type", "time", "label", "confidence"],
        "properties": {
          "slot": { "type": "integer", "minimum": 1, "maximum": 8 },
          "type": {
            "type": "string",
            "enum": ["INTRO", "VOCAL", "BUILD", "DROP", "BREAK", "SECOND_DROP", "OUTRO", "CUSTOM"]
          },
          "time": { "type": "number", "minimum": 0 },
          "label": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "color": { "type": "string" },
          "locked": { "type": "boolean" },
          "source": { "type": "string" },
          "reason": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "strategyUsed": { "type": "string" },
    "genreDetected": { "type": "string" },
    "genreConfidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
